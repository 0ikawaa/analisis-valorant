# Copiá este archivo como  .env  y completá los valores.

# API key de HenrikDev. Se pide gratis en https://api.henrikdev.xyz/dashboard/
# Formato: HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VALORANT_API_KEY=HDEV-pega-tu-key-aca

# Tu Riot ID completo, con el tag y sin el #  ->  usá el formato Nombre#TAG
VALORANT_PLAYER=Nombre#TAG

# Opcional: región (ap, br, eu, kr, latam, na). Si lo dejás vacío se detecta sola.
VALORANT_REGION=

# Opcional: modo de juego a analizar (competitive, unrated, swiftplay, deathmatch, all)
VALORANT_MODE=competitive
